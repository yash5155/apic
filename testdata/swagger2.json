{
  "swagger": "2.0",
  "info": { "title": "Legacy Store", "version": "1.5" },
  "host": "api.legacy.test",
  "basePath": "/v2",
  "schemes": ["https"],
  "paths": {
    "/items": {
      "get": {
        "summary": "List items",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": ["active", "archived"]
          },
          { "name": "limit", "in": "query", "type": "integer", "default": 25 }
        ]
      },
      "post": {
        "summary": "Create an item",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Item" }
          }
        ]
      }
    },
    "/items/{itemId}": {
      "parameters": [
        { "name": "itemId", "in": "path", "required": true, "type": "string" }
      ],
      "get": { "summary": "Get an item" },
      "delete": { "summary": "Delete an item" }
    }
  },
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer" },
        "active": { "type": "boolean" }
      }
    }
  }
}
